# =============================================================================
# astroid.club — example environment
#
# Local development:  copy this file to `.env.local` (gitignored) and fill in
#                     real values. Never commit `.env*` files.
#
# Preview deployment (preview.astroid.club): the values below are split into
# two surfaces, see `docs/PREVIEW_DEPLOY.md` for the full runbook:
#   - GATEWAY (Fly.io / Railway / Render container) — every var below except
#     the ones in the `shell/` block at the bottom. Set via `fly secrets set`
#     or your host's secrets UI; do NOT bake real values into the image.
#   - SHELL (Vercel project) — only the `NEXT_PUBLIC_*` block at the bottom.
#     Set via Vercel project → Settings → Environment Variables.
# =============================================================================

# -- runtime ------------------------------------------------------------------
NODE_ENV=development
PORT=3002

# -- chain posture ------------------------------------------------------------
# Master kill switch. When UNSET it defaults to OFF; with CHAIN_ENABLED=false
# the on-chain code paths are present but all transfers are no-ops returning
# placeholder txids — game logic still executes, but no funds move and no real
# signatures are produced.
#
# This template sets it to `true` because the holder gate + Quarry staking UI
# need a live RPC. Flipping to `true` REQUIRES SOLANA_RPC_URL and
# ASTROID_MINT_ADDRESS to be set (the boot fn fail-loud refuses to start
# otherwise). Quarry STAKING additionally requires the QUARRY_* / IOU_* block
# below — without it, staking ops reply `chain_disabled`. See
# `docs/CHAIN_AUDIT.md` for the full operator runbook.
CHAIN_ENABLED=true

# -- solana (only used when CHAIN_ENABLED=true) -------------------------------
# Standard JSON-RPC endpoint. Helius RPC URLs are recommended. Examples:
#   mainnet: https://mainnet.helius-rpc.com/?api-key=<KEY>
#   devnet:  https://devnet.helius-rpc.com/?api-key=<KEY>
# The reader auto-selects mainnet vs devnet by checking whether the URL
# contains "devnet"; no separate flag needed.
#
# NEVER commit a real API key here. Copy this file to .env.local (which is
# gitignored), drop the real key in there, and leave this template
# placeholder in place. If a key does land in commit history, rotate it in
# the Helius dashboard — the rotation is the only real fix.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>

# Optional Helius API key. When set, the holder reader prefers Helius's
# DAS REST endpoint (faster, indexed) and falls back to plain JSON-RPC on
# error. Safe to leave blank if you're using a non-Helius RPC; the reader
# will use `getParsedTokenAccountsByOwner` directly.
#
# NOTE: this is NOT the same string as your RPC URL — the URL embeds the
# key, but the reader needs it standalone for the DAS endpoint too.
HELIUS_API_KEY=<HELIUS_API_KEY>

# $ASTROID token mint (placeholder until launch).
# Required when CHAIN_ENABLED=true; boot will refuse to start otherwise.
ASTROID_MINT_ADDRESS=8NwtzwGm4CV8Hm4fJXR69ac1MxDYuSaN3A9HVyikpump
# pump.fun mints use 6 decimals. The Helius reader also prefers per-token
# decimals from the API response, so this is the fallback for the JSON-RPC
# path and any future Helius response that omits the field.
ASTROID_DECIMALS=6

# Reward / escrow wallets (KEEP SECRET, never log).
# Not used by the verify_holder / arena slices — they're read-only. These
# only matter once the bet-escrow / yield-payout slices are wired live.
# Only consulted when REWARD_MODE=onchain (per-event SPL transfer). In the
# default ledger/sweepstakes posture, mining accrues in-game credits and no
# per-discovery transfer happens.
REWARD_WALLET_PRIVATE_KEY=
ESCROW_WALLET_PRIVATE_KEY=
# Optional priority fee (micro-lamports) applied to reward-payout txs when
# REWARD_MODE=onchain. Leave blank for none.
REWARD_PRIORITY_MICROLAMPORTS=

# -- on-chain Quarry staking (only used when CHAIN_ENABLED=true) --------------
# These wire QuarryStakingAdapter at boot. If QUARRY_REWARDER_ADDRESS and
# QUARRY_ADDRESS are unset, the staking ops (build_stake_tx, build_unstake_tx,
# build_claim_tx, verify_stake_tx, stake_info) reply `chain_disabled` and the
# console staking panel shows "staking unavailable". Create these accounts via
# scripts/deploy/deploy-quarry-guarded.ts (or the localnet flow in
# docs/LOCALNET_STAKING.md), then paste the printed addresses here / into
# `fly secrets set`.
#
# Required to enable staking:
QUARRY_REWARDER_ADDRESS=
QUARRY_ADDRESS=
# Optional (read-only emissions controller; informational):
QUARRY_MINT_WRAPPER=
#
# IOU-ASTROID reward token (Quarry emissions). Required for build_claim_tx /
# build_redeem_tx. Decimals default to 9 when unset.
IOU_TOKEN_MINT=
IOU_TOKEN_DECIMALS=9
# Wallet that collects redeemed IOU-ASTROID. Required for build_redeem_tx.
# NOTE: build_redeem_tx only TRANSFERS IOU to this wallet — the $ASTROID
# payback (redeemer/buyback service) is a separate, not-yet-built slice
# (see docs/READINESS.md Phase B).
REDEEMER_WALLET_ADDRESS=
#
# Treasury HOT WALLET private key (JSON 64-byte array OR base58 string). This
# single key custodies the IOU/$ASTROID float AND co-signs settlement for:
#   - the IOU bridge + redeem swap (server/chain/redeemer.ts), and
#   - raid-wager ESCROW (server/chain/bet-escrow-chain.ts): players deposit
#     their wager into this treasury's $ASTROID ATA; a win returns it, a loss
#     burns 90% + pays 10% to defenders — all server-signed by this key.
# When set (with CHAIN_ENABLED=true + SOLANA_RPC_URL + ASTROID_MINT_ADDRESS),
# raid-wager escrow auto-wires; when unset, wagers stay cosmetic (no custody).
# SECURITY: fund it with only what you're willing to expose and keep a buffer
# above total locked wagers; the durable escrow_wagers ledger is the liability
# source of truth. Never commit a real key. Read once, in-memory, never logged.
REDEEMER_TREASURY_PRIVATE_KEY=
#
# OPTIONAL dedicated escrow hot wallet (JSON 64-byte array OR base58 string).
# When set, raid-wager escrow custodies wagers in THIS wallet instead of the
# redeemer treasury, so escrowed funds are NOT commingled with the redeem
# float (redeem outflows can't starve wager payouts). Recommended for mainnet.
# Fund it with $ASTROID; it server-signs returns/burns/defender-spoils. When
# unset, escrow falls back to REDEEMER_TREASURY_PRIVATE_KEY (single-wallet).
ESCROW_PRIVATE_KEY=
#
# Escrow-creation fee — charged to the player ON TOP of the wager and routed to
# the mining treasury (REDEEMER_TREASURY_PRIVATE_KEY pubkey) as protocol
# revenue. fee = ceil(wager * ESCROW_FEE_BPS/10000) + ESCROW_FEE_FLAT (token
# units). The escrow ATA still receives EXACTLY the wager (verify gate intact).
# When escrow runs on a dedicated ESCROW_PRIVATE_KEY, the fee is kept SEPARATE
# on the treasury; in the single-wallet fallback it commingles on that wallet.
ESCROW_FEE_BPS=200
ESCROW_FEE_FLAT=5000
#
# Rent-offset burn — when a settlement payout must CREATE a recipient ATA (the
# escrow wallet fronts ~0.002 SOL rent), also burn the $ASTROID-equivalent of
# that rent (live oracle-priced) in the same tx, as a deflationary offset.
# Burned strictly from escrow SURPLUS (balance above outstanding liability) —
# never from funds backing live wagers. Set to `false` to disable.
ESCROW_RENT_BURN_ENABLED=true

# -- mining / discovery loop --------------------------------------------------
# The discovery trigger turns elapsed mining time + drill power into resolved
# discoveries (found "seeds") and pays them through the yield orchestrator.
# Enabled by default; set to false to freeze the economy (no yield produced).
DISCOVERY_ENABLED=true
# Reference drill power: the power at which an asteroid's EXPECTED time between
# discoveries equals its baseDiscoveryTimeMs. Finds are probabilistic (a per-tick
# % roll), so set this to the expected solo drill power (the client default is
# 5000) so a lone miner finds on the design cadence. Raise to slow the economy,
# lower to speed it up.
DISCOVERY_REFERENCE_DRILL_POWER=5000
# Safety cap: max discoveries resolved per asteroid per maintenance tick.
# Bounds payouts even if the reference power is mis-tuned or the loop pauses.
DISCOVERY_MAX_PER_ASTEROID_PER_TICK=1
# Anti-spoof drill-power bound. Drill power is self-reported by the client
# (there is no proof-of-work), so without a bound any wallet can claim the 10M
# hard cap regardless of stake and dominate shared-asteroid yield splits and
# raid attack power. The reported BASE drill is clamped to
#   DRILL_BASE_FREE + stake x DRILL_BASE_PER_STAKE
# before the tier multiplier is applied: everyone gets a free baseline and extra
# headroom scales with their staked position. Set DRILL_STAKE_BOUND=off to
# disable (legacy unbounded behaviour).
DRILL_STAKE_BOUND=on
DRILL_BASE_FREE=5000
DRILL_BASE_PER_STAKE=1

# -- gameplay tuning ----------------------------------------------------------
# Percent of each discovery routed into the persistent, raidable raid vault
# (the asteroid "treasury"); the rest pays miners per-discovery. Default 20.
# RAID_VAULT_PERCENT=20
# Meteor-strike spawn probability per ~60s world tick (idle-miner gamification).
# Lower = rarer strikes. Default 0.04 (~one meteor every ~25 min when eligible).
# METEOR_SPAWN_CHANCE=0.04
# Raid cooldowns (minutes). Time before a wallet can launch another raid, and
# the recovery window after one ends. Defaults: 10 and 5.
# RAID_START_COOLDOWN_MIN=10
# RAID_RECOVERY_COOLDOWN_MIN=5
# Idle-raid fallback (minutes): a raid auto-resolves after this even if the
# target never makes a discovery (raids normally resolve on the target's next
# discovery, which gives defenders a rally window). Default 10.
# RAID_MAX_DURATION_MIN=10

# -- drill-power stake tiers (USD-pegged) -------------------------------------
# Tier cost is denominated in USD; the required $ASTROID token amount is derived
# from the live $ASTROID/USD price (Jupiter Price API V3) so the dollar cost is
# stable as the token price moves. Token amount for a tier = USD target / price.
# USD targets per tier (default $50 / $100 / $200 / $400):
# STAKE_TIER_BRONZE_USD=50
# STAKE_TIER_SILVER_USD=100
# STAKE_TIER_GOLD_USD=200
# STAKE_TIER_DIAMOND_USD=400
# Static TOKEN floors used only when no live price is available yet (pre-fetch
# or oracle outage). Defaults assume a ~$0.005 price.
# STAKE_TIER_BRONZE=10000
# STAKE_TIER_SILVER=50000
# STAKE_TIER_GOLD=250000
# STAKE_TIER_DIAMOND=1000000
# Optional: pin a starting price before the first oracle fetch (USD per token).
# STAKE_TIER_FALLBACK_PRICE=0.005
# Price-oracle poll cadence in ms (default 300000 = 5 min).
# STAKE_TIER_PRICE_REFRESH_MS=300000
# Optional Jupiter API key (higher rate limits; keyless works at ~0.5 rps).
# JUP_API_KEY=

# -- emission governor (reserve protection) -----------------------------------
# Mining issues redeemable credits 1:1 against the treasury backing. Without a
# cap, more miners => more issuance, which can outrun the reserve. The governor
# tapers issuance as the OUTSTANDING liability (lifetime earned - redeemed)
# approaches the budget. Redeeming frees headroom back up (recirculation-aware).
#
# EMISSION_BUDGET: STATIC max outstanding credit liability before issuance
# stops, in $ASTROID credit units. Normally the live budget is PEGGED to the
# treasury (see EMISSION_BACKING_FRACTION) and this only acts as a floor /
# fallback before the first balance poll or when chain is off. 0 = no static
# floor.
EMISSION_BUDGET=0
# EMISSION_BACKING_FRACTION: when chain + treasury + mint are configured, the
# governor's budget is pegged DYNAMICALLY to the redeemer treasury's live
# $ASTROID balance × this fraction (a safety buffer). 0.8 keeps 20% in reserve
# and makes issuance scale automatically with the treasury as the userbase
# grows from ~10 to 100+ miners. Set lower to be more conservative.
EMISSION_BACKING_FRACTION=0.8
# Fraction of the (effective) budget over which yield tapers full->0. 0.25 =>
# full yield until liability hits 75% of budget, then linear down to 0 at 100%.
EMISSION_TAPER_FRACTION=0.25
# Hard ceiling on credits issued per rolling 24h window (smooths bursts).
# Default 250000; raise as the treasury + userbase grow. 0 = disabled.
EMISSION_DAILY_CAP=250000
# Base reward per discovery (before resource/asteroid multipliers + variance).
# Default 50 (halved from the legacy 100) to slow accumulation; tune to taste.
YIELD_BASE_PER_DISCOVERY=50
# Reward posture (sweepstakes / IOU model):
#   ledger  (default) — mining accrues redeemable in-game credits; the only
#                        on-chain step is an explicit redemption (legally
#                        cleaner: players win a redeemable credit, not the
#                        asset itself). REWARD_WALLET_PRIVATE_KEY not required.
#   onchain           — every discovery fires a real $ASTROID SPL transfer
#                        (requires REWARD_WALLET_PRIVATE_KEY).
REWARD_MODE=ledger

# -- holder verification ------------------------------------------------------
# Minimum $ASTROID balance required to qualify for the club.
HOLDER_MIN_BALANCE=10000
# Continuous hold time in seconds before a wallet qualifies (flash-loan guard).
# 600s = 10 minutes; matches Black-Gold's production setting.
HOLDER_MIN_HOLD_SECONDS=6000

# Pre-warm the holder gate from on-chain transfer history. When `true` (default)
# AND `HELIUS_API_KEY` is set, the gateway reverse-simulates balance over a
# wallet's recent token transfers on its first verify and seeds the in-memory
# tracker with the inferred hold-start timestamp. Long-time holders therefore
# qualify on first click instead of waiting the full HOLDER_MIN_HOLD_SECONDS
# window. Pre-warm is *not* a substitute for the in-memory tracker — it only
# pre-seeds the first observation; threshold dips still reset tracking.
# Disable to fall back to the BG-style "first seen by gateway" semantic.
HOLDER_PREWARM_ENABLED=true
# Maximum recent transactions the pre-warmer walks back per wallet. Capped at
# Helius's 100-per-page limit. Wallets whose threshold-crossing transfer is
# older than the lookback window report the oldest fetched tx as a conservative
# undercount of true hold time (still safe; just less generous).
HOLDER_PREWARM_MAX_LOOKBACK=100

# -- security -----------------------------------------------------------------
# Comma-separated list of allowed CORS origins for the REST/WS gateway.
# The gateway also enforces this list at the WebSocket-upgrade layer
# (origin header), so a browser from any other origin gets a 403 before
# the engine ever sees the connection.
#
# For preview.astroid.club:
#   CORS_ALLOWED_ORIGINS=https://preview.astroid.club
# For local dev (default):
#   CORS_ALLOWED_ORIGINS=http://localhost:4001
CORS_ALLOWED_ORIGINS=http://localhost:4001
#
# Optional wallet allowlist. When set, ONLY these wallet addresses can
# authenticate — every other wallet is rejected after a valid signature,
# regardless of $ASTROID holdings. Leave blank for an open (holder-gated)
# deploy. Use it to lock a mainnet/preview test to your own wallets:
#   WALLET_ALLOWLIST=YourWallet1Pubkey,YourWallet2Pubkey
WALLET_ALLOWLIST=
# Admin console token. When set, a live read-only monitoring dashboard is
# served by the gateway at  https://<gateway-host>/admin  (paste this token
# to unlock it). Shows connected players, asteroids, the economy, security
# stats, and a live server log. If unset, /admin is disabled entirely.
# Use a long random string, e.g.  openssl rand -hex 32
ADMIN_SECRET=

# -- storage ------------------------------------------------------------------
# Durable game state (home stations + the pending-yield / IOU credit ledger).
# The gateway picks the strongest option configured:
#   DATABASE_URL (Postgres)  >  REDIS_URL  >  in-memory (wiped on redeploy).
#
# PRODUCTION — Postgres / Supabase (auditable, append-only ledger; system of
# record). Apply db/schema.sql once, then set the connection string. SSL is
# enabled automatically. Works with Supabase, Neon, Fly/Railway Postgres.
#   postgresql://postgres.PROJECT:PASSWORD@HOST.pooler.supabase.com:5432/postgres
# Full step-by-step setup: docs/SUPABASE.md
DATABASE_URL=
#
# QUICK / PREVIEW — Redis (durable current-balance CACHE; no audit history).
# Fine for preview testing. Use a TLS URL in production, e.g.
#   rediss://default:PASSWORD@host:6379
# Free managed options: Upstash (serverless) or `fly redis create`.
# Full step-by-step setup: docs/REDIS.md
REDIS_URL=

# =============================================================================
# shell/ (Next.js) — these are read at build time by Next.js. Re-`npm run dev`
# (or rebuild) after changing any NEXT_PUBLIC_* var.
# =============================================================================

# Privy app id. When set, the shell mounts Privy for external Solana wallets
# (Phantom, Backpack, Solflare, Glow, etc.). When UNSET, the shell falls back
# to a localStorage-backed dev keypair — useful for local development without
# a Privy account.
#
# Get one at https://dashboard.privy.io. Configure your app for "external
# wallets only · Solana" to match the shell's posture.
NEXT_PUBLIC_PRIVY_APP_ID=cmowh1eqb01450cjrgr1gv98k

# Feature flag for the poker freeroll utility tile on the landing page.
# Disabled by default until counsel/operator approvals come through.
NEXT_PUBLIC_FEATURE_POKER=false

# Absolute origin used to resolve OG image, robots.txt, sitemap.xml, and
# canonical URLs. MUST match the live shell domain.
#   Local dev:                http://localhost:4001
#   Preview:                  https://preview.astroid.club
NEXT_PUBLIC_SITE_URL=http://localhost:4001

# Public entry gate for the game. Defaults OFF: the apex (astroid.club)
# shows ONLY the coming-soon landing — no "enter" CTA, in-game nav links
# hidden. The /arena route stays reachable by direct URL and is still
# gated by Privy + the server-side WALLET_ALLOWLIST, so allowlisted
# wallets can test before launch. Flip to `true` once Privy production +
# on-chain holder reads are wired to open the doors publicly.
NEXT_PUBLIC_ARENA_OPEN=false

# WS / HTTP overrides for the shell. Defaults below match a local server.
# Override in production to point at your gateway.
#   Local dev:                ws://localhost:3002, http://localhost:3002
#   Preview (Fly.io default): wss://gw.astroid.club, https://gw.astroid.club
#                             (the gateway accepts both ws:// and wss:// — Fly
#                              terminates TLS for you when the proxy is on)
NEXT_PUBLIC_ASTROID_WS_URL=ws://localhost:3002
NEXT_PUBLIC_ASTROID_HTTP_URL=http://localhost:3002

# On-chain staking (Quarry) — read by the shell's staking flow.
#
#   NEXT_PUBLIC_SOLANA_CHAIN — which cluster Privy external wallets submit
#     staking transactions to. The wallet uses its own RPC for this cluster,
#     so only the cluster name matters here.
#       solana:devnet | solana:mainnet | solana:testnet
#   NEXT_PUBLIC_SOLANA_RPC_URL — only used by the *dev keypair* signing path
#     (no browser-extension wallet). Point it at your localnet/devnet RPC so
#     dev-mode staking can submit + confirm. Leave unset in privy/prod builds.
#       Localnet: http://127.0.0.1:8899
#       Devnet:   https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CHAIN=solana:devnet
# NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
