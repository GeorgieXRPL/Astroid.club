# Astroid Club - example environment.
#
# v1 (coming-soon page) is fully static and does not require any
# environment variables. This file is here so that when we open the
# waitlist (form + Supabase + optional Solana balance check), the
# expected variable names are already documented.

# Public site URL - used in metadata + canonical tags.
NEXT_PUBLIC_SITE_URL=https://astroid.club

# --- Reserved for the waitlist launch (NOT used in v1) ---

# Solana RPC for read-only $ASTROID balance verification of waitlist
# entries (badge only, never custodial).
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# $ASTROID SPL token mint address.
# ASTROID_MINT=

# Minimum balance (in whole tokens) to flag an entry as a verified holder.
# MIN_HOLDER_BALANCE=1

# Supabase (server-side, service-role) for the waitlist table.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
